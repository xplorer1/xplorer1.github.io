@article{ugwuanyi2026afarena,
  abbr={ICML 2026},
  title={AF-Arena: An Evaluation Arena for Multi-Axis Alignment Faking in Frontier Language Models},
  author={Ugwuanyi, Chijioke and Zhang, Terry Jingchen and Sch{\"o}lkopf, Bernhard and Jin, Zhijing},
  journal={Workshop on Agents in the Wild (AIWILD), ICML 2026 (Oral). Under review at NeurIPS 2026 (Datasets \& Benchmarks Track).},
  year={2026},
  abstract={We introduce AF-Arena, an evaluation arena that tests whether frontier language models fake alignment across five behavioral axes (sycophancy, sandbagging, goal-guarding, selective disclosure, and corrigibility) rather than only the single compliance setting of prior work. Evaluating nine frontier models across 54,000 trials, we find alignment faking is widespread but strongly axis- and model-dependent, and we characterize three novel failure modes of prompt-based mitigations: behavioral masking, meta-alignment-faking, and self-aware alignment faking.},
  selected={true},
  bibtex_show={true}
}

@article{zhang2026ambench,
  abbr={Preprint},
  title={AM-Bench: A Unified Taxonomy and Evaluation Suite for Agentic Misalignment},
  author={Zhang, Eric and Zhang, Terry Jingchen and Ugwuanyi, Chijioke and Shi, Jerick and Sch{\"o}lkopf, Bernhard and Jin, Zhijing},
  journal={Submitted to NeurIPS 2026},
  year={2026},
  abstract={We propose AM-Bench, a unified taxonomy and evaluation benchmark for agentic misalignment grounded in the fraud triangle, decomposing goal-directed misconduct into perceived pressure, perceived opportunity, and rationalization. Across 35 realistic scenarios spanning seven industry verticals, our evaluation of 11 frontier models reveals a 57-percentage-point gap in misalignment, and our rationalization framework shows that agentic misalignment can occur without full situational awareness.},
  code={https://github.com/AI4Collaboration/am-bench},
  selected={true},
  bibtex_show={true}
}

@misc{ugwuanyi2026systemprompts,
  abbr={LessWrong},
  title={From 8B to Frontier: How System Prompts Control Whether AI Agents Blackmail, Leak, and Kill},
  author={Ugwuanyi, Chijioke},
  year={2026},
  howpublished={LessWrong},
  abstract={Extending Lynch et al. (2025) across 22 models from 8B to frontier scale, this study finds that susceptibility to agentic misalignment (blackmail, leaking, and harmful action) is driven by model family and system-prompt framing rather than model size, with the latest OpenAI and Anthropic models near-immune while DeepSeek models remain highly vulnerable.},
  html={https://www.lesswrong.com/posts/GviHfFBB9tsefmDkG/from-8b-to-frontier-how-system-prompts-control-whether-ai},
  selected={true}
}

